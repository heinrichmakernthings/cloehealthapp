{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloehealthapp",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloehealthapp-db",
      "database_id": "4e9ebc31-9722-424f-9168-2d4bf74f909e"
    }
  ]
}
